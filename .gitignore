# local planning archive (never published). docs/temp/ is the scratch directory
# those notes are written in: a design doc that lives there is working material,
# not repository content, and once it is finished it moves to docs/archive/ --
# still local, still never published.
docs/archive/
docs/temp/

# Agent artifacts: design/architecture documents and diagrams written by the
# designer prompts and the diagram tool. Not repository content.
/doc/

# Skill output: avenger and bigbang write their reports here (workspace data,
# not repository content).
docs/sop/
